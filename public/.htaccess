<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Jeśli plik nie istnieje fizycznie, przekieruj na index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# Wybor wersji PHP na hostingu mydevil (kilka wersji dostepnych rownoczesnie na koncie).
# Jesli wdrazasz gdzie indziej i host inaczej wybiera wersje PHP, ta linia jest zbedna.
AddType application/x-httpd-php82 .php
