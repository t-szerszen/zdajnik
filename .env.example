# Baza danych
DB_HOST=db
DB_NAME=zdajnik_db
DB_USER=root
DB_PASS=root_password
DATABASE_URL=mysql://root:root_password@db:3306/zdajnik_db

# Adres aplikacji
BASE_URL=http://localhost:8080

# Mailer (SMTP)
# OVH/Zimbra zwykle używa smtp.mail.ovh.net albo ssl0.ovh.net dla Europy.
SMTP_HOST=smtp.mail.ovh.net
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=noreply@zdajnik.pl
SMTP_PASS=your_password_here
MAIL_FROM_ADDRESS=noreply@zdajnik.pl
MAIL_FROM_NAME="Zdajnik - Inteligentna Nauka"
CONTACT_EMAIL=kontakt@zdajnik.pl

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Cloudflare Turnstile (Ochrona przed spamem)
# Klucz witryny - widoczny publicznie w HTML, używany do ładowania widgetu
TURNSTILE_SITE_KEY="key"
# Tajny klucz - trzymany na serwerze, używany do weryfikacji tokenu z Cloudflare
TURNSTILE_SECRET_KEY="secret-key"
